{
  "name": "decky-kettle-framegen",
  "version": "0.1.1",
  "description": "Frame generation per game with the kettle-framegen Vulkan layer",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types tests/*.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arunoruto/decky-kettle-framegen.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "frame-generation",
    "vulkan"
  ],
  "author": "Mirza Arnaut",
  "license": "BSD-3-Clause",
  "homepage": "https://github.com/arunoruto/decky-kettle-framegen#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.12.1",
    "@types/node": "^22.0.0",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  },
  "packageManager": "pnpm@12.9.0"
}
